{
  "type": "module",
  "private": true,
  "name": "plainsound-hexatone",
  "version": "3.3-beta",
  "engines": {
    "node": ">=24 <25"
  },
  "repository": "git@github.com:PLAINSOUND/hexatone.git",
  "scripts": {
    "start": "vite",
    "start:https": "VITE_DEV_HTTPS=true vite",
    "osc-bridge": "node osc-bridge/index.js",
    "build-bridge": "node osc-bridge/build-sea.mjs",
    "build": "vite build && node copy-build-docs.mjs && node generate-sw.js",
    "generate:preset-tunings": "node scripts/generate-preset-tunings.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepare": "husky"
  },
  "dependencies": {
    "normalize.css": "^8.0.1",
    "preact": "^10.28.4",
    "webmidi": "^3.1.14",
    "xen-dev-utils": "^0.12.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@preact/preset-vite": "^2.10.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.5.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.4.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.8.2",
    "prop-types": "^15.8.1",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^6.4.3",
    "vite-plugin-svgr": "^4.5.0",
    "vitest": "^3.2.6",
    "workbox-build": "^7.4.0"
  },
  "packageManager": "yarn@4.14.1",
  "resolutions": {
    "vite": "6.4.3"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": "eslint --max-warnings=0"
  }
}
